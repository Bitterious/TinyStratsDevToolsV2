		<Item class="LocalScript" referent="RBX5F5E147E5B1846588DA9A9752BAAF46C">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local tweenservice = game:GetService("TweenService")
local gui = script.Parent

local toggleti = TweenInfo.new(.1, Enum.EasingStyle.Linear)
local menutoggled = false

gui.Buttons.Size = UDim2.fromOffset(0, 64)
gui.MainContainer.Visible = false
gui.MainContainer.Explorer.Visible = false
gui.MainContainer.UploadUI.Visible = false
gui.MenuToggle.MouseButton1Click:Connect(function()
	menutoggled = not menutoggled
	if menutoggled then
		tweenservice:Create(gui.MenuToggle.Image.ImageLabel, toggleti, {
			Rotation = 90
		}):Play()
		tweenservice:Create(gui.MenuToggle.UIGradient, toggleti, {
			Offset = Vector2.new(-1, 0)
		}):Play()
		tweenservice:Create(gui.Buttons, toggleti, {
			Size = UDim2.fromOffset(244, 64)
		}):Play()
	else
		tweenservice:Create(gui.MenuToggle.Image.ImageLabel, toggleti, {
			Rotation = 0
		}):Play()
		tweenservice:Create(gui.MenuToggle.UIGradient, toggleti, {
			Offset = Vector2.new(1, 0)
		}):Play()
		tweenservice:Create(gui.Buttons, toggleti, {
			Size = UDim2.fromOffset(0, 64)
		}):Play()
	end
	gui.MainContainer.Visible = menutoggled
end)

gui.Buttons.Owned.MouseButton1Click:Connect(function()
	gui.MainContainer.Explorer.Visible = not gui.MainContainer.Explorer.Visible
	if gui.MainContainer.Explorer.Visible then
		gui.MainContainer.Explorer.Position = UDim2.fromOffset(8, 80)
		gui.Buttons.Owned.BackgroundColor3 = Color3.new(1,1,1)
		gui.Buttons.Owned.ImageColor3 = Color3.fromRGB(32,32,32)
	else
		gui.Buttons.Owned.BackgroundColor3 = Color3.fromRGB(32,32,32)
		gui.Buttons.Owned.ImageColor3 = Color3.new(1,1,1)
	end
end)]]></ProtectedString>
